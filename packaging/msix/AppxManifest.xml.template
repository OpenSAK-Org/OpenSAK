<?xml version="1.0" encoding="utf-8"?>
<!--
  AppxManifest.xml TEMPLATE for OpenSAK's MSIX prototype (issue #786, step 1).

  This packages the existing PyInstaller Windows build (dist/OpenSAK/,
  built from opensak.spec) as-is using the "Desktop Bridge" approach —
  i.e. a plain Win32 app run via Windows.FullTrustApplication, NOT a
  UWP/rewritten app. Nothing about opensak.spec or the app itself changes.

  Placeholders to fill in before packaging — see packaging/msix/README.md
  for where each one comes from:

    __IDENTITY_NAME__          e.g. "12345AllanGreen.OpenSAK"
                                (Partner Center-assigned once the app name
                                is reserved; for LOCAL sideload testing
                                before that exists, any dot-separated
                                string works as long as it matches your
                                self-signed test certificate's subject.)
    __PUBLISHER_CN__            e.g. "CN=1A2B3C4D-...-EXAMPLE"
                                (Partner Center Publisher ID for a real
                                submission; for local testing, the Subject
                                of your self-signed test cert.)
    __PUBLISHER_DISPLAY_NAME__  e.g. "Allan Green" or "OpenSAK"
    __DISPLAY_NAME__            App name shown in Start Menu / Store listing,
                                e.g. "OpenSAK" for a stable release or
                                "OpenSAK Beta" for a beta release — see
                                README.md "Naming beta vs. stable
                                releases" for how this is derived.
    __VERSION__                 4-part numeric version, e.g. "1.17.2.0"
                                (MSIX does not allow "-beta.N" suffixes —
                                see README for the mapping used here)
    __EXE_RELATIVE_PATH__       relative path to opensak.exe inside the
                                package, e.g. "OpenSAK\opensak.exe"
                                (matches the dist/OpenSAK/ folder layout
                                produced by opensak.spec's COLLECT step)
    __CLI_EXE_RELATIVE_PATH__   the same for the console program,
                                e.g. "OpenSAK\opensak-cli.exe" (#937)
    __CLI_ALIAS__               the command name of the App Execution
                                Alias: "opensak.exe" for a stable release,
                                "opensak-beta.exe" for a beta, so both can
                                be installed side by side — see README.md
                                "Command line (App Execution Alias)"

  Two applications: "OpenSAK" is the Start Menu app (the windowed
  opensak.exe). "OpenSAKCLI" is the console opensak-cli.exe for scripts and
  the Task Scheduler (#937): no Start Menu entry (AppListEntry="none"), only
  the alias, which puts __CLI_ALIAS__ on the user's PATH
  (%LOCALAPPDATA%\Microsoft\WindowsApps). desktop4:Subsystem="console"
  makes a shell wait for it and keep its output and exit code; an alias to
  the windowed exe would start it but not wait. Its DisplayName is the
  package's own on purpose: Partner Center rejects display names that are
  not reserved (README.md "Known Partner Center quirks"). Windows shows it
  only in Settings → Apps → App execution aliases, next to the alias.

  Capabilities: only `runFullTrust` (required for any Desktop Bridge app)
  and `internetClient` (OpenSAK's update checker, Leaflet/OSM tile
  fetches, and reverse-geocoding boundary downloads all need outbound
  HTTPS). No filesystem/broadFileSystemAccess capability is requested —
  OpenSAK's database files live under the user's normal per-app data
  folder, not restricted locations, and Desktop Bridge apps get standard
  Win32 file I/O without needing that capability.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap rescap uap5 desktop4 desktop6">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER_CN__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>__DISPLAY_NAME__</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>assets\Square150x150Logo.png</Logo>
    <Description>Free, open-source, cross-platform geocache management tool.</Description>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>

  <Applications>
    <Application Id="OpenSAK" Executable="__EXE_RELATIVE_PATH__" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="__DISPLAY_NAME__"
        Description="Free, open-source, cross-platform geocache management tool."
        BackgroundColor="transparent"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" Square71x71Logo="assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
    <Application Id="OpenSAKCLI" Executable="__CLI_EXE_RELATIVE_PATH__" EntryPoint="Windows.FullTrustApplication"
                 desktop4:Subsystem="console" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="__DISPLAY_NAME__"
        Description="OpenSAK on the command line, for scripts and scheduled runs."
        BackgroundColor="transparent"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="__CLI_EXE_RELATIVE_PATH__" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="__CLI_ALIAS__" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
