<?xml version="1.0" encoding="utf-8"?>
<!--
  tests/fixtures/macros/examples.gpx — the small test database the example
  macros run against (test_example_macros_1202.py) and whose values the
  schema test checks (test_macro_db_schema_1202.py). Imported with the GPX
  importer, with "Tester" (member id 999) as the account in Settings.

  Two countries with two states each; finds, a DNF run and own hides by
  Tester; a mystery whose listing holds coordinates and a formula
  (puzzle_helper.lua); a multi with waypoints; attributes and trackables.
  Add caches rather than change these: the tests count on them.
-->
<gpx xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.0"
     creator="Groundspeak Pocket Query" xmlns="http://www.topografix.com/GPX/1/0"
     xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
  <name>Example macros</name>
  <time>2026-01-31T08:00:00Z</time>

  <wpt lat="46.948" lon="7.4474">
    <time>2019-04-12T00:00:00</time>
    <name>GCEX001</name>
    <desc>Bear Pit by Ursus, Traditional Cache (1.5/2)</desc>
    <url>https://coord.info/GCEX001</url>
    <urlname>Bear Pit</urlname>
    <sym>Geocache Found</sym>
    <type>Geocache|Traditional Cache</type>
    <groundspeak:cache id="9001" archived="False" available="True">
      <groundspeak:name>Bear Pit</groundspeak:name>
      <groundspeak:placed_by>Ursus</groundspeak:placed_by>
      <groundspeak:owner id="501">Ursus</groundspeak:owner>
      <groundspeak:type>Traditional Cache</groundspeak:type>
      <groundspeak:container>Small</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="1" inc="1">Dogs</groundspeak:attribute>
        <groundspeak:attribute id="6" inc="1">Recommended for kids</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.5</groundspeak:difficulty>
      <groundspeak:terrain>2</groundspeak:terrain>
      <groundspeak:country>Switzerland</groundspeak:country>
      <groundspeak:state>Bern</groundspeak:state>
      <groundspeak:county>Bern-Mittelland</groundspeak:county>
      <groundspeak:short_description html="False">Near the bears.</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p&gt;A quick find in the old town.&lt;/p&gt;</groundspeak:long_description>
      <groundspeak:encoded_hints>Behind the sign</groundspeak:encoded_hints>
      <groundspeak:logs>
        <groundspeak:log id="10011">
          <groundspeak:date>2025-05-10T00:00:00Z</groundspeak:date>
          <groundspeak:type>Found it</groundspeak:type>
          <groundspeak:finder id="999">Tester</groundspeak:finder>
          <groundspeak:text encoded="False">Quick find, TFTC.</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="10012">
          <groundspeak:date>2024-08-01T00:00:00Z</groundspeak:date>
          <groundspeak:type>Found it</groundspeak:type>
          <groundspeak:finder id="601">Hiker</groundspeak:finder>
          <groundspeak:text encoded="False">Found it.</groundspeak:text>
        </groundspeak:log>
      </groundspeak:logs>
      <groundspeak:travelbugs>
        <groundspeak:travelbug id="7001" ref="TBEX01">
          <groundspeak:name>Racing Snail</groundspeak:name>
        </groundspeak:travelbug>
      </groundspeak:travelbugs>
    </groundspeak:cache>
  </wpt>

